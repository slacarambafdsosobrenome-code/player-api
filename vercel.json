{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/embed.js": {
      "includeFiles": "public/player/**"
    },
    "api/watch.js": {
      "includeFiles": "public/player/**",
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/embed",
      "destination": "/api/embed"
    },
    {
      "source": "/filme/:linha",
      "destination": "/api/watch?type=filme&linha=:linha"
    },
    {
      "source": "/serie/:aba/:linha",
      "destination": "/api/watch?type=serie&aba=:aba&linha=:linha"
    }
  ],
  "headers": [
    {
      "source": "/player/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/sdk/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
